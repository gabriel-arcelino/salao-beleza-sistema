{
  "testCommand": "node scripts/onp-pgtap-verify.cjs",
  "reporter": "tap",
  "testGlobs": [
    "test/**",
    "tests/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "__tests__/**",
    "supabase/tests/**"
  ],
  "srcGlobs": [
    "src/**"
  ],
  "ignoreGlobs": [
    "node_modules/**",
    ".git/**",
    "dist/**",
    "build/**",
    "coverage/**",
    ".spec/**",
    "supabase/migrations/**"
  ]
}
